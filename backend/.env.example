# Provider da LLM: use GEMINI para Google AI Studio ou LOCAL para rodar sem API externa.
LLM_PROVIDER=GEMINI

# Chave criada no Google AI Studio. Nunca coloque a chave real neste arquivo.
GEMINI_API_KEY=sua-chave-do-google-ai-studio

# Modelo Gemini usado pelo backend.
GEMINI_MODEL=gemini-flash-latest

# Caminho do banco SQLite.
PRODUCT_DB_FILE=backend/products.db
